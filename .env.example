DATABASE_URL=postgresql+psycopg2://semantic:semantic@localhost:5433/semantic_search
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MAX_UPLOAD_SIZE_BYTES=52428800
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DEFAULT_TOP_K=5
MAX_TOP_K=20
INIT_DB_ON_STARTUP=true
# For local dev only: keep the default secret and set ALLOW_INSECURE_JWT=true.
# For anything exposed on a network: use a long random JWT_SECRET and leave ALLOW_INSECURE_JWT=false.
JWT_SECRET=local-dev-secret-change-before-exposing
ALLOW_INSECURE_JWT=true
JWT_EXPIRE_MINUTES=1440
POSTGRES_USER=semantic
POSTGRES_PASSWORD=semantic
POSTGRES_DB=semantic_search
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CATEGORY_MIN_SCORE=0.35
MIN_SEARCH_SCORE=0.25
MAX_CONCURRENT_UPLOAD_JOBS=2
MAX_PDF_PAGES=200
MAX_EXTRACTED_TEXT_CHARS=2000000
MAX_CHUNKS_PER_DOCUMENT=2000
AUTH_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=20
SEARCH_RATE_LIMIT_PER_MINUTE=60
